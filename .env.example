# Copiez ce fichier vers .env pour le développement local.

DATABASE_URL="file:./dev.db"

# Auth.js (NextAuth v5) — secret utilisé pour signer les cookies de session JWT.
# Générez le vôtre avec : openssl rand -base64 33  (ou `npx auth secret`)
AUTH_SECRET=""
# Mettre à "true" si l'app tourne derrière un proxy/tunnel en développement.
AUTH_TRUST_HOST="true"

# --- Solvers VRPTW externes (optionnels) ---
# Si aucun des deux n'est configuré, l'optimisation utilise la simulation interne.

# OpenRouteService : clé API gratuite sur https://openrouteservice.org/dev/#/signup
# Utilisée pour calculer une matrice de distances/durées sur le réseau routier réel
# (Belgique incluse), combinée à l'heuristique de tournée de PharmaRoute FX.
ORS_API_KEY=""

# VROOM : URL d'une instance VROOM (auto-hébergée). Si définie, prioritaire sur ORS
# car VROOM résout lui-même le VRPTW (meilleure qualité de tournées).
# Voir https://github.com/VROOM-Project/vroom-docker pour un déploiement rapide.
VROOM_API_URL=""

# Google Route Optimization API (Cloud Fleet Routing) : nécessite un projet GCP avec
# l'API "Route Optimization API" activée et un compte de service disposant du rôle
# adéquat. Collez ici le contenu JSON complet du fichier de clé de compte de service
# (Console GCP > IAM & Admin > Comptes de service > Clés > Créer une clé JSON).
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_CLOUD_PROJECT_ID=""
