// PharmaRoute FX — Schéma de base de données
// Outil d'optimisation de tournées VRPTW pour grossistes-répartiteurs (Belgique)
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  /// Accès complet : import, création/lancement d'optimisation, modification.
  DISPATCHER
  /// Accès restreint : uniquement ses feuilles de route (mobile), lecture + case à cocher.
  DRIVER
}

/// Compte utilisateur (authentification par email/mot de passe).
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(DRIVER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Tournées assignées à ce chauffeur (rôle DRIVER)
  routes Route[] @relation("RouteDriver")

  @@map("users")
}

/// Dépôt central (point de départ / retour des tournées)
model Depot {
  id          String   @id @default(cuid())
  name        String
  address     String
  postalCode  String
  city        String
  latitude    Float?
  longitude   Float?
  /// Heure d'ouverture du dépôt / heure de départ par défaut, format "HH:mm"
  openingTime String   @default("06:30")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  optimizations Optimization[]

  @@map("depots")
}

/// Jour de la semaine où une livraison est envisageable (marché belge : pas de tournée le dimanche)
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

/// Créneau du jour
enum DeliveryPeriod {
  MORNING
  AFTERNOON
}

/// Pharmacie cliente (point de livraison)
model Pharmacy {
  id        String  @id @default(cuid())
  /// Code APB (Association Pharmaceutique Belge) — identifiant officiel de l'officine
  apbCode   String  @unique
  name      String
  address   String
  /// Code postal belge à 4 chiffres
  postalCode String
  city      String
  latitude  Float?
  longitude Float?

  /// Nombre de bacs/caisses à livrer pour cette pharmacie
  bacsCount Int @default(1)

  /// Temps de déchargement fixe sur place, en minutes
  serviceTimeMinutes Int @default(5)

  contactName  String?
  contactPhone String?
  notes        String?

  /// Livraison hors-horaires possible (sas de dépôt / clé confiée au chauffeur) :
  /// le chauffeur peut accéder au point de dépôt avant l'heure d'ouverture
  /// officielle de l'officine, sans que celle-ci (grille horaire ci-dessous,
  /// affichée telle quelle sur la fiche pharmacie) ne soit modifiée.
  earlyAccessEnabled Boolean @default(false)
  /// Heure la plus tôt à laquelle le chauffeur peut effectuer le dépôt (sas/clé),
  /// format "HH:mm" — utilisée par le solver comme horaire d'accès anticipé.
  earlyAccessTime String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Grille hebdomadaire des créneaux de livraison (Lundi-Samedi, Matin/Après-midi).
  /// L'absence de ligne pour un (jour, créneau) donné signifie "fermé" à ce moment-là.
  timeWindows PharmacyTimeWindow[]
  stops       RouteStop[]

  @@map("pharmacies")
}

/// Un créneau de livraison ouvert pour une pharmacie, un jour de la semaine donné.
model PharmacyTimeWindow {
  id String @id @default(cuid())

  pharmacyId String
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  weekday Weekday
  period  DeliveryPeriod

  /// Début du créneau, format "HH:mm" (ex: "08:30")
  startTime String
  /// Fin du créneau, format "HH:mm" (ex: "12:30")
  endTime   String

  @@unique([pharmacyId, weekday, period])
  @@map("pharmacy_time_windows")
}

enum OptimizationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// Fournisseur de solver VRPTW utilisé pour le calcul
enum SolverProvider {
  INTERNAL
  GOOGLE_ROUTE_OPTIMIZATION
  OPENROUTE_VROOM
}

/// Un lancement d'optimisation (= un ensemble de tournées calculées à un instant T)
model Optimization {
  id     String @id @default(cuid())
  depotId String
  depot   Depot  @relation(fields: [depotId], references: [id])

  /// Nombre de véhicules disponibles pour cette optimisation
  vehicleCount Int
  /// Heure de départ du dépôt, format "HH:mm"
  departureTime String
  /// Date de livraison ciblée — détermine le jour de la semaine utilisé pour
  /// sélectionner les créneaux horaires (matin/après-midi) de chaque pharmacie.
  /// (défaut = date de création, pour compatibilité avec les optimisations existantes)
  deliveryDate DateTime @default(now())

  status         OptimizationStatus @default(PENDING)
  solverProvider SolverProvider     @default(INTERNAL)

  /// Sélection explicite de pharmacies faite par le dispatcher avant le calcul
  /// (liste d'ids sérialisée en JSON). `null` = aucune sélection manuelle,
  /// toutes les pharmacies ouvertes ce jour-là ont été incluses.
  selectedPharmacyIds String?

  totalDistanceKm  Float?
  totalDurationMin Int?
  /// Nombre d'arrêts dont la fenêtre horaire n'a pas été respectée
  violationsCount  Int?
  errorMessage     String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  routes Route[]

  @@map("optimizations")
}

/// Une tournée assignée à un véhicule au sein d'une optimisation
model Route {
  id             String @id @default(cuid())
  optimizationId String
  optimization   Optimization @relation(fields: [optimizationId], references: [id], onDelete: Cascade)

  /// Ex: "Véhicule 1"
  vehicleLabel String
  vehicleIndex Int

  totalDistanceKm  Float?
  totalDurationMin Int?
  /// Géométrie de l'itinéraire (GeoJSON / liste de coordonnées sérialisée en JSON)
  geometry         String?
  /// Couleur d'affichage sur la carte (hex)
  colorHex         String  @default("#2563eb")

  /// Chauffeur (rôle DRIVER) assigné à cette tournée — donne accès à sa feuille de route
  driverId String?
  driver   User?   @relation("RouteDriver", fields: [driverId], references: [id])

  stops RouteStop[]

  @@map("routes")
}

/// Un arrêt (livraison pharmacie) au sein d'une tournée, dans l'ordre de passage
model RouteStop {
  id String @id @default(cuid())

  routeId String
  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  pharmacyId String
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id])

  /// Position dans la séquence de la tournée (1 = premier arrêt après le dépôt)
  sequence Int

  /// Heure de livraison effective, format "HH:mm" (= heure d'arrivée du véhicule,
  /// ou heure d'ouverture du créneau s'il arrive en avance et doit patienter)
  etaArrival String
  /// Heure de départ de l'arrêt (heure de livraison + temps de déchargement), format "HH:mm"
  etaDeparture String

  /// La fenêtre horaire de la pharmacie est-elle respectée ?
  withinTimeWindow Boolean @default(true)
  /// Créneau (matin/après-midi) retenu pour cette livraison, parmi ceux ouverts ce jour-là
  deliveryPeriod DeliveryPeriod?
  /// Copie du créneau appliqué au moment du calcul, format "HH:mm" (indépendant
  /// d'une modification ultérieure de la grille horaire de la pharmacie)
  scheduledWindowStart String?
  scheduledWindowEnd   String?

  distanceFromPrevKm  Float?
  durationFromPrevMin Int?

  /// Le chauffeur a-t-il coché cette livraison comme effectuée ? (feuille de route, écran 4)
  completed   Boolean   @default(false)
  completedAt DateTime?
  /// Nombre de bacs vides récupérés par le chauffeur lors du passage
  emptyBacsRetrieved Int @default(0)

  @@map("route_stops")
}
